# Steht ein TLS-Proxy davor, dessen Schema weiterreichen, sonst das eigene.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API über denselben Origin ausliefern, damit das Login-Cookie ohne CORS funktioniert.
    location /api/ {
        # Über Variable + Docker-DNS auflösen, damit ein neu erstellter API-Container
        # (neue IP) ohne Neustart von nginx erreichbar bleibt.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Gehashte Build-Dateien (outputHashing) dürfen lange gecacht werden.
    location ~* \.(?:js|css|woff2?)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Client-seitiges Routing: unbekannte Pfade liefern die App aus.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
