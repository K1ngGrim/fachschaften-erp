# Copy to .env and adjust: cp .env.example .env

# ── General ──────────────────────────────────────────────────────────────────
# Public URL the app is reached under (used in invitation links).
APP_BASE_URL=http://localhost:8080
# Host port of the web container, and the interface it binds to
# (use 127.0.0.1 when a reverse proxy on the same host terminates TLS).
HTTP_PORT=8080
HTTP_BIND=0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=erp
POSTGRES_USER=erp
# Required. Generate one e.g. with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Initial admin (only used on the very first start with an empty database) ─
ADMIN_USERNAME=admin
ADMIN_EMAIL=
# Leave empty to generate a random password that is printed to the API log.
# Must satisfy the password policy. Has to be changed on first login either way.
ADMIN_INITIAL_PASSWORD=

# ── Email (invitations) ──────────────────────────────────────────────────────
# Dev = only write emails to the API log; Mailjet = send via Mailjet.
EMAIL_PROVIDER=Dev
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Fachschaften ERP
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# true = Mailjet validates but does not deliver (for testing the setup).
MAILJET_SANDBOX_MODE=false
